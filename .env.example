# Copy to .env and adjust. Never commit the real .env (see .gitignore).

KRISHIAI_ENV=development
LOG_LEVEL=INFO

# Paths
DATA_ROOT=./data
MODELS_ROOT=./models
# Incoming dataset saves (separate from training data). On Render, this is ephemeral.
# For production, configure external persistent storage (S3, Cloudinary, etc.)
INCOMING_DATA_ROOT=./data/incoming
MAX_UPLOAD_SIZE_MB=10

# Hardware / inference (Section 13, 79)
MODEL_DEVICE=auto          # auto | cpu | cuda:0
CONFIDENCE_THRESHOLD=0.5   # placeholder — must be tuned experimentally (Section 39)
IOU_THRESHOLD=0.45

# API
API_HOST=0.0.0.0
API_PORT=8000

# Optional Gemini-first whole-image diagnosis, followed by an independent YOLO26 cross-check.
# Keep the real key in your ignored local .env file or Render environment settings.
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current stable model; supports image input and structured output.
GEMINI_MODEL=models/gemini-3.5-flash-lite
GEMINI_VISION_ENABLED=true
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_DETECTIONS=4
GEMINI_CORRECTION_THRESHOLD=0.82
GEMINI_MAX_RETRIES=1
